# OpenAI API Configuration
# デモモードのみを使用する場合は、これらの設定は不要です

# OpenAI APIキー（必須）
# 社内プロキシの場合: ok-****** 形式
# 通常のOpenAI: sk-****** 形式
VITE_OPENAI_API_KEY=

# OpenAI APIのベースURL（オプション、デフォルト: https://api.openai.com/v1）
# 社内プロキシの例: https://openai-proxy-apigw-genai.api.linecorp.com/v1
VITE_OPENAI_BASE_URL=

# プロキシ用のカスタムヘッダー（オプション）
# 社員IDなど、プロキシに送る識別情報
VITE_OPENAI_USER_ID=

# アプリケーション識別子（オプション）
# 社内アプリの識別用
VITE_OPENAI_APP_TITLE=jump-planning-trial
